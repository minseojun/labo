rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 본인 프로필만 읽기/쓰기
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /todos/{todoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    match /labs/{labId} {
      function isMember() {
        return request.auth != null &&
          exists(/databases/$(database)/documents/labs/$(labId)/members/$(request.auth.uid));
      }

      function memberRole() {
        return get(/databases/$(database)/documents/labs/$(labId)/members/$(request.auth.uid)).data.role;
      }

      function isProfessor() {
        return isMember() && memberRole() == '교수';
      }

      function canEditSupply() {
        return isMember() && memberRole() in ['대학원생', '교수'];
      }

      // 연구실 기본 정보: 멤버만 읽기, 교수만 수정, 누구나 생성(신규 연구실)
      allow read: if isMember();
      allow create: if request.auth != null;
      allow update: if isProfessor();
      allow delete: if isProfessor();

      // 멤버
      match /members/{memberId} {
        allow read: if isMember();
        allow create: if request.auth != null && request.auth.uid == memberId;
        allow update: if request.auth != null && (request.auth.uid == memberId || isProfessor());
        allow delete: if isProfessor();
      }

      // 일정 & 잡무
      match /schedules/{schedId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update: if isMember();
        allow delete: if isMember();
      }

      // 장비: 생성/삭제는 교수만, 사용 기록 업데이트는 모든 멤버
      match /equipment/{equipId} {
        allow read: if isMember();
        allow create: if isProfessor();
        allow update: if isMember();
        allow delete: if isProfessor();

        match /comments/{commentId} {
          allow read: if isMember();
          allow create: if isMember();
          allow delete: if isMember() && isProfessor();
        }
      }

      // 소모품: 생성/수정은 대학원생 이상, 삭제는 교수만
      match /supplies/{supplyId} {
        allow read: if isMember();
        allow create: if canEditSupply();
        allow update: if canEditSupply();
        allow delete: if isProfessor();
      }

      // 공지사항: 생성/완료처리는 모든 멤버, 삭제는 교수만
      match /notices/{noticeId} {
        allow read: if isMember();
        allow create: if isMember();
        allow update: if isMember();
        allow delete: if isProfessor();

        match /comments/{commentId} {
          allow read: if isMember();
          allow create: if isMember();
          allow delete: if isMember() && isProfessor();
        }
      }
    }
  }
}
