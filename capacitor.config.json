{
  "appId": "com.labo.app",
  "appName": "LABO",
  "webDir": "dist",
  "backgroundColor": "#F1F1F4",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#F1F1F4"
  },
  "android": {
    "backgroundColor": "#F1F1F4"
  },
  "plugins": {
    "Keyboard": {
      "resize": "none"
    },
    "LocalNotifications": {
      "iconColor": "#0E6B45"
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#0E6B45",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#F1F1F4"
    }
  }
}
